generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  name         String
  status       String   @default("PLANNING")
  prompt       String?
  architecture String?
  prismaSchema String?
  targetPath   String?
  apiCode      String?
  uiCode       String?
}
